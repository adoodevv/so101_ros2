<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <!-- controllers_file: ros2_control controller YAML for gz_ros2_control; empty
         means so101_moveit_config/config/<robot_name>/ros2_controllers.yaml. -->
    <xacro:macro name="load_gazebo_sim_ros2_control_plugin" params="robot_name use_gazebo controllers_file:=''">
        <xacro:if value="${use_gazebo}">
            <xacro:property name="default_controllers_file"
                            value="$(find so101_moveit_config)/config/${robot_name}/ros2_controllers.yaml"/>
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>${controllers_file or default_controllers_file}</parameters>
                    <ros>
                        <remapping>/controller_manager/robot_description:=/robot_description</remapping>
                    </ros>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>