<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <!--
      Hardware backend (at most one may be true):
        use_gazebo        -> gz_ros2_control/GazeboSimSystem (Gazebo Harmonic)
        use_fake_hardware -> mock_components/GenericSystem (headless, no physics)
        use_real_hardware -> so101_hardware/SO101SystemHardware (Feetech STS3215
                             servos on `port`, LeRobot `calibration_file`)
      initial_positions_file: YAML with an `initial_positions` map keyed by
        unprefixed joint name. Only read when use_fake_hardware is true; empty
        means so101_moveit_config/config/so101/initial_positions.yaml.
    -->
    <xacro:macro name="so101_ros2_control"
                 params="prefix use_gazebo use_fake_hardware:=false initial_positions_file:=''
                         use_real_hardware:=false port:=/dev/ttyACM0 calibration_file:=''
                         baud_rate:=1000000 read_only:=false">
        <xacro:if value="${int(use_gazebo) + int(use_fake_hardware) + int(use_real_hardware) > 1}">
            ${xacro.fatal('so101_ros2_control: at most one of use_gazebo, use_fake_hardware and use_real_hardware can be true')}
        </xacro:if>
        <xacro:if value="${use_real_hardware and calibration_file == ''}">
            ${xacro.fatal('so101_ros2_control: use_real_hardware needs calibration_file (the LeRobot calibration JSON)')}
        </xacro:if>

        <xacro:if value="${use_fake_hardware}">
            <xacro:property name="default_initial_positions_file"
                            value="$(find so101_moveit_config)/config/so101/initial_positions.yaml"/>
            <xacro:property name="initial_positions"
                            value="${xacro.load_yaml(initial_positions_file or default_initial_positions_file)['initial_positions']}"/>
        </xacro:if>

        <!-- Adds an initial_value to a state interface; fake hardware only. -->
        <xacro:macro name="initial_value" params="joint">
            <xacro:if value="${use_fake_hardware}">
                <param name="initial_value">${initial_positions[joint]}</param>
            </xacro:if>
        </xacro:macro>

        <!-- Real hardware only: calibration key of the joint's servo, and the extra
             feedback the servos provide. load is a fraction of max torque (-1..1),
             not a calibrated effort. -->
        <xacro:macro name="real_joint" params="motor">
            <xacro:if value="${use_real_hardware}">
                <state_interface name="velocity"/>
                <state_interface name="load"/>
                <state_interface name="temperature"/>
                <state_interface name="voltage"/>
                <param name="motor">${motor}</param>
            </xacro:if>
        </xacro:macro>

        <ros2_control name="${prefix}RobotSystem" type="system">
            <hardware>
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_fake_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">false</param>
                </xacro:if>
                <xacro:if value="${use_real_hardware}">
                    <plugin>so101_hardware/SO101SystemHardware</plugin>
                    <param name="port">${port}</param>
                    <param name="baud_rate">${baud_rate}</param>
                    <param name="calibration_file">${calibration_file}</param>
                    <param name="read_only">${read_only}</param>
                </xacro:if>
            </hardware>

            <joint name="${prefix}shoulder_pan">
                <command_interface name="position">
                    <param name="min">-1.91986</param>
                    <param name="max">1.91986</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="shoulder_pan"/>
                </state_interface>
                <xacro:real_joint motor="shoulder_pan"/>
            </joint>

            <joint name="${prefix}shoulder_lift">
                <command_interface name="position">
                    <param name="min">-1.74533</param>
                    <param name="max">1.74533</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="shoulder_lift"/>
                </state_interface>
                <xacro:real_joint motor="shoulder_lift"/>
            </joint>

            <joint name="${prefix}elbow_flex">
                <command_interface name="position">
                    <param name="min">-1.69</param>
                    <param name="max">1.69</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="elbow_flex"/>
                </state_interface>
                <xacro:real_joint motor="elbow_flex"/>
            </joint>

            <joint name="${prefix}wrist_flex">
                <command_interface name="position">
                    <param name="min">-1.65806</param>
                    <param name="max">1.65806</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="wrist_flex"/>
                </state_interface>
                <xacro:real_joint motor="wrist_flex"/>
            </joint>

            <joint name="${prefix}wrist_roll">
                <command_interface name="position">
                    <param name="min">-2.74385</param>
                    <param name="max">2.84121</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="wrist_roll"/>
                </state_interface>
                <xacro:real_joint motor="wrist_roll"/>
            </joint>

            <joint name="${prefix}gripper">
                <command_interface name="position">
                    <param name="min">-0.174533</param>
                    <param name="max">1.74533</param>
                </command_interface>
                <state_interface name="position">
                    <xacro:initial_value joint="gripper"/>
                </state_interface>
                <!-- No controller uses these, and mock hardware would only echo
                     zeros, so they are omitted with use_fake_hardware. They stay
                     elsewhere so joint_state_broadcaster keeps publishing them in
                     Gazebo. In Gazebo the effort is the simulated joint effort:
                     it is not contact or grip-force sensing. -->
                <xacro:unless value="${use_fake_hardware or use_real_hardware}">
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </xacro:unless>
                <xacro:real_joint motor="gripper"/>
                <xacro:if value="${use_real_hardware}">
                    <!-- Servo range [range_min, range_max] maps linearly onto the
                         command limits above (closed .. open). -->
                    <param name="mapping">linear</param>
                    <!-- LeRobot's gripper protection: 50 % torque and current,
                         25 % torque when overloaded, so a blocked grip cannot
                         burn the servo. -->
                    <param name="max_torque_limit">500</param>
                    <param name="protection_current">250</param>
                    <param name="overload_torque">25</param>
                </xacro:if>
            </joint>

        </ros2_control>
    </xacro:macro>

</robot>
